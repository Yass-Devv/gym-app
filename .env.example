# Copie ce fichier en .env.production (ou .env.local) et adapte les valeurs. Elles sont lues au moment du build.

# Adresse publique du site, sans barre finale : sert au référencement (canonical, aperçu de partage)
REACT_APP_SITE_URL=https://www.exemple.fr

# Adresse du serveur API. Inutile en développement (proxy vers localhost:4000) ;
# obligatoire pour l'appli mobile et si l'API est hébergée ailleurs que le site. Toujours en https en production.
REACT_APP_API_URL=https://api.exemple.fr
