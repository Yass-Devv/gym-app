{
  "name": "yass-gym-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "npm run db:init && node --env-file-if-exists=.env src/index.js",
    "db:init": "node --env-file-if-exists=.env src/db/init.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
